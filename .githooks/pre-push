#!/bin/sh
# 하네스 pre-push 훅.
#   1층(객관): tsc(전체) + vitest(변경분만, merge-base(dev) 대비) — 깨지면 push 중단.
#   2층(주관): headless QA(haiku)가 기능 체크리스트 + 커버리지 매트릭스 생성 (비차단).
#   패키징 게이트: QA 산출물이 미커밋이면 중단(커밋 후 재push).
# 활성화: git config core.hooksPath .githooks  (클론당 1회)

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# ── 1층: 객관 게이트 (tsc + vitest) — LLM 비용 전에 결정적으로 막는다 ─────────
#   대상 패키지는 아래 목록으로 고정한다. 존재하지 않는 경로는 건너뛴다 — 이 훅이 다른 구조의
#   저장소(예: 하네스만 분리한 저장소)에서도 push 를 부당하게 막지 않게 하기 위함이다.
TSC_DIRS="apps/web packages/ui"
echo "[pre-push] 객관 게이트: tsc 검사..."
FAIL=0
for d in $TSC_DIRS; do
  if [ ! -d "$d" ]; then
    echo "[pre-push] ⚠ $d 없음 — tsc 건너뜀"
    continue
  fi
  ( cd "$d" && npx tsc --noEmit ) || FAIL=1
done
if [ "$FAIL" = "1" ]; then
  echo "[pre-push] ❌ 타입 에러 — push 중단"
  exit 1
fi
# vitest: 전체 스위트가 아니라 "이 브랜치가 dev에서 분기한 이후 변경한 파일 + 그 의존
#   그래프에 걸린 테스트"만 돈다(`--changed <merge-base>`). 이유: worktree가 dev보다 뒤처지면
#   전체 스위트엔 이 브랜치가 안 건드린(=dev에서 이미 고쳐졌지만 여기엔 아직 없는) stale 테스트가
#   섞여 push가 부당하게 막힌다. merge-base 기준이 핵심 — `dev`를 직접 diff하면(2-dot) dev가
#   앞선 변경까지 "차이"로 잡혀 stale 테스트가 되돌아온다. 공통 조상만 diff하면 순수 브랜치 변경분만.
#   변경분이 없으면 vitest가 "No test files"로 exit 1 → `--passWithNoTests`로 통과시킨다.
TEST_DIR="packages/ui"
BASE="$(git merge-base origin/dev HEAD 2>/dev/null || git merge-base dev HEAD 2>/dev/null)"
if [ ! -d "$TEST_DIR" ]; then
  echo "[pre-push] ⚠ $TEST_DIR 없음 — vitest 건너뜀"
elif [ -n "$BASE" ]; then
  echo "[pre-push] 객관 게이트: packages/ui vitest (변경분만, base=$BASE)..."
  ( cd packages/ui && npx vitest run --changed "$BASE" --passWithNoTests ) \
    || { echo "[pre-push] ❌ packages/ui 테스트 실패 — push 중단"; exit 1; }
else
  echo "[pre-push] ⚠ merge-base(dev) 산출 실패 — 전체 스위트로 폴백"
  ( cd packages/ui && npx vitest run ) \
    || { echo "[pre-push] ❌ packages/ui 테스트 실패 — push 중단"; exit 1; }
fi

# ── 현재 브랜치의 태스크 spec/qa 경로 ─────────────────────────────────────────
SPEC="$(node -e "try{const i=require('./harness/index.json');process.stdout.write(i.tasks['$BRANCH']||'')}catch(e){}")"
if [ -z "$SPEC" ]; then
  echo "[pre-push] 등록된 spec 없음 — QA 생략, push 허용"
  exit 0
fi
QA="$(dirname "$SPEC")/qa-checklist.md"

# ── 2층: 입력 해시 스킵 (변동 없으면 QA 안 돌림) ──────────────────────────────
NEW_HASH="$(node .claude/hooks/qa-hash.mjs "$BRANCH")"
OLD_HASH="$(sed -n 's/^input_hash:[[:space:]]*//p' "$QA" 2>/dev/null | head -1)"
if [ -n "$OLD_HASH" ] && [ "$NEW_HASH" = "$OLD_HASH" ]; then
  echo "[pre-push] QA 입력 불변 — 생략, push 허용"
  exit 0
fi

# ── QA 생성 (headless Claude). 실패해도 push는 막지 않는다(비차단). ───────────
if ! command -v claude >/dev/null 2>&1; then
  echo "[pre-push] ⚠ claude CLI 없음 — QA 생략, push 허용"
  exit 0
fi
echo "[pre-push] QA 커버리지 생성 중 (headless)..."
claude -p "당신의 역할은 .claude/agents/qa.md에 정의돼 있다. 먼저 그 파일을 Read 하라.
현재 브랜치($BRANCH)의 기능 목록은 $SPEC 이다. 그 spec으로 기능 체크리스트를 독립 도출하고,
테스트 코드를 읽어 커버리지 매트릭스를 $QA 에 작성하라.
frontmatter의 input_hash를 정확히 '$NEW_HASH' 로 기록하라." \
  --model haiku \
  --permission-mode acceptEdits \
  --allowedTools "Read,Grep,Glob,Edit,Write" \
  --disallowedTools "Bash" \
  --output-format text \
  < /dev/null || { echo "[pre-push] ⚠ QA 실행 실패 — push 허용"; exit 0; }

# ── 패키징 게이트: QA 산출물이 미커밋이면 중단 ────────────────────────────────
if [ -n "$(git status --porcelain "$QA")" ]; then
  echo "[pre-push] 📝 QA 산출물이 갱신/생성되었습니다: $QA"
  echo "           검토 후 커밋하고 다시 push 하세요:"
  echo "             git add \"$QA\" && git commit -m \"docs: QA 커버리지 매트릭스\" && git push"
  exit 1
fi

echo "[pre-push] ✅ 통과"
exit 0
