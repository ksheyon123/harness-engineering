#!/bin/sh
# 하네스 pre-push 훅.
#   1층(객관): scripts/gate.mjs — 단, pre-commit 이 이미 검증한 트리면 건너뛴다.
#   2층(주관): headless QA(haiku)가 기능 체크리스트 + 커버리지 매트릭스 생성 (비차단).
#   패키징 게이트: QA 산출물이 미커밋이면 중단(커밋 후 재push).
# 활성화: git config core.hooksPath .githooks  (scripts/setup-githooks.mjs 가 자동 수행)
# 설계는 harness/gate-pipeline/spec.md 참고.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# ── 1층: 객관 게이트 ─────────────────────────────────────────────────────────
# pre-commit 이 통과시킨 트리 해시를 마커에 남긴다. HEAD 의 트리가 그것과 같으면
# 지금 push 되는 내용은 이미 검증된 것이므로 게이트를 다시 돌지 않는다.
#
# 그럼에도 이 게이트를 없애지 않는 이유: pre-commit 을 거치지 않고 만들어지는 트리가 있다.
#   · git rebase / 자동 머지 — pre-commit 이 실행되지 않는다. 이 하네스는 dev 재분기를
#     규약으로 요구하므로 흔하다. 각각은 통과하지만 합치면 깨지는 semantic conflict 는
#     pre-commit 이 원리적으로 잡을 수 없다(그 조합은 커밋 시점에 존재하지 않았다).
#   · git commit --no-verify, 다른 도구/클론에서 온 커밋.
# 마커가 없거나 다르면 안전 기본값 = 게이트 실행.
#
# 한계: 게이트를 실행하는 경로에서 gate.mjs 는 워킹트리를 검사하지 HEAD 의 트리를
# 체크아웃해 검사하지 않는다. 워킹트리가 dirty 하면 push 되는 내용과 검사 대상이 다를 수
# 있다. (스킵 경로에는 이 문제가 없다 — 커밋 시점에 검증된 트리와 HEAD 트리가 같음을 확인한다.)
GIT_DIR_PATH="$(git rev-parse --absolute-git-dir)"
MARKER="$GIT_DIR_PATH/harness-gate-tree"
HEAD_TREE="$(git rev-parse HEAD^{tree} 2>/dev/null)"
GATE_TREE="$(cat "$MARKER" 2>/dev/null)"

if [ -n "$HEAD_TREE" ] && [ "$HEAD_TREE" = "$GATE_TREE" ]; then
  echo "[pre-push] 객관 게이트: pre-commit 에서 검증된 트리 — 생략"
else
  echo "[pre-push] 객관 게이트 실행..."
  node scripts/gate.mjs || { echo "[pre-push] ❌ 객관 게이트 실패 — push 중단"; exit 1; }
fi

# ── 현재 브랜치의 태스크 spec/qa 경로 ─────────────────────────────────────────
SPEC="$(node -e "try{const i=require('./harness/index.json');process.stdout.write(i.tasks['$BRANCH']||'')}catch(e){}")"
if [ -z "$SPEC" ]; then
  echo "[pre-push] 등록된 spec 없음 — QA 생략, push 허용"
  exit 0
fi
QA="$(dirname "$SPEC")/qa-checklist.md"

# ── 2층: 입력 해시 스킵 (변동 없으면 QA 안 돌림) ──────────────────────────────
NEW_HASH="$(node .claude/hooks/qa-hash.mjs "$BRANCH")"
OLD_HASH="$(sed -n 's/^input_hash:[[:space:]]*//p' "$QA" 2>/dev/null | head -1)"
if [ -n "$OLD_HASH" ] && [ "$NEW_HASH" = "$OLD_HASH" ]; then
  echo "[pre-push] QA 입력 불변 — 생략, push 허용"
  exit 0
fi

# ── QA 생성 (headless Claude). 실패해도 push는 막지 않는다(비차단). ───────────
if ! command -v claude >/dev/null 2>&1; then
  echo "[pre-push] ⚠ claude CLI 없음 — QA 생략, push 허용"
  exit 0
fi
echo "[pre-push] QA 커버리지 생성 중 (headless)..."
claude -p "당신의 역할은 .claude/agents/qa.md에 정의돼 있다. 먼저 그 파일을 Read 하라.
현재 브랜치($BRANCH)의 기능 목록은 $SPEC 이다. 그 spec으로 기능 체크리스트를 독립 도출하고,
테스트 코드를 읽어 커버리지 매트릭스를 $QA 에 작성하라.
frontmatter의 input_hash를 정확히 '$NEW_HASH' 로 기록하라." \
  --model haiku \
  --permission-mode acceptEdits \
  --allowedTools "Read,Grep,Glob,Edit,Write" \
  --disallowedTools "Bash" \
  --output-format text \
  < /dev/null || { echo "[pre-push] ⚠ QA 실행 실패 — push 허용"; exit 0; }

# ── 패키징 게이트: QA 산출물이 미커밋이면 중단 ────────────────────────────────
if [ -n "$(git status --porcelain "$QA")" ]; then
  echo "[pre-push] 📝 QA 산출물이 갱신/생성되었습니다: $QA"
  echo "           검토 후 커밋하고 다시 push 하세요:"
  echo "             git add \"$QA\" && git commit -m \"docs: QA 커버리지 매트릭스\" && git push"
  exit 1
fi

echo "[pre-push] ✅ 통과"
exit 0
