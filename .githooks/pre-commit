#!/bin/sh
# 하네스 pre-commit 훅 — '게이트를 통과해야 커밋' 을 하드 게이트로 만든다.
#
# 이게 없으면 git commit 은 무조건 성공하고, 게이트 실패가 항상 *커밋이 만들어진 뒤*
# push 시점에 드러난다. 그러면 깨진 커밋이 로컬 히스토리에 남아 --amend 나 fix 커밋이
# 필요해지고, 수정이 테스트/spec 파일에 닿으면 QA 입력 해시가 바뀌어 push 시도가
# 3회까지 늘어난다. 실패를 커밋 앞으로 옮기면 워킹트리만 dirty 한 상태로 끝난다.
#
# 활성화: git config core.hooksPath .githooks  (scripts/setup-githooks.mjs 가 자동 수행)
# 설계는 harness/gate-pipeline/spec.md 참고.

# 훅 자신의 진단 출력은 반드시 이 헬퍼로 낸다.
#
# 이유: 훅의 차단 여부가 '출력을 끝까지 쓰는 데 성공했는가' 에 의존하면 안 된다.
# 호출자가 stdout 을 EOF 전에 닫는 소비자에게 넘기면(`git commit | head -6`, `| grep -q` 등)
# 훅이 진단을 쓰다가 SIGPIPE 로 죽고, `exit 1` 에 도달하지 못해 **막아야 할 커밋이 조용히
# 통과한다**(실제로 재현됨 — 훅이 어느 exit 문에도 도달하지 못했다).
#
# 서브셸은 별개 프로세스라 죽어도 부모(훅)는 비0 상태를 받을 뿐이고, 부모는 아무것도 쓰지
# 않았으므로 exit 문까지 도달한다. `>&2` 는 관례이자 이중 보험(보통 파이프에 묶이는 건 stdout).
# `trap '' PIPE` 로도 되지만 자식 프로세스의 SIGPIPE 처리까지 바꾸므로 쓰지 않는다.
#
# gate.mjs 의 stdio:inherit 은 그대로 둔다 — vitest/tsc 출력은 복사본이 아니라 원본 라이브
# 스트림이고, 실패 원인은 그것으로 충분하다.
say() { ( printf '%s\n' "$@" ) >&2 || true; }

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# ── 0) 부분 스테이징 거부 ────────────────────────────────────────────────────
# 훅은 워킹트리를 검사하는데 커밋되는 것은 인덱스다. 둘이 다르면 '통과했다고 판정한
# 트리' 와 '실제 커밋되는 트리' 가 어긋나 거짓 통과가 난다.
# 일반적 해법은 스테이징 안 된 변경을 stash 했다 복원하는 것이지만 stash 실패 시
# 작업 손실이라는 비가역 위험이 있다. 하네스는 spec 당 코드+테스트+qa-checklist 를
# 한 커밋에 담는 것이 규약이라 부분 스테이징을 쓸 일이 없으므로, 지원하지 않고 거부한다.
if ! git diff --quiet; then
  say "[pre-commit] ❌ 스테이징되지 않은 변경이 있습니다." \
      "             훅은 워킹트리를 검사하므로, 이 상태로 커밋하면 검사한 내용과" \
      "             실제 커밋되는 내용이 달라집니다. 전부 스테이징한 뒤 커밋하세요:" \
      "" \
      "$(git --no-pager diff --name-only | sed 's/^/               /')" \
      "" \
      "               git add -A && git commit ..."
  exit 1
fi

# ── 1) 객관 게이트 ───────────────────────────────────────────────────────────
# gate.mjs 의 출력(vitest/tsc)은 라이브로 그대로 흐른다 — 실패 원인은 그것으로 본다.
# 파이프가 닫혀 vitest 가 SIGPIPE 로 죽으면 게이트 실패로 판단되는데, 거짓 거부지만
# 방향이 안전하므로(막는 쪽) 그대로 둔다.
if ! node scripts/gate.mjs; then
  say "[pre-commit] ❌ 객관 게이트 실패 — 커밋을 중단합니다." \
      "             워킹트리의 수정 내용은 그대로 남아 있습니다. 고친 뒤 다시 커밋하세요."
  exit 1
fi

# ── 2) 통과한 트리를 기록 ────────────────────────────────────────────────────
# pre-push 가 '이 트리는 이미 검증됐다' 를 판단하는 근거. 커밋 해시가 아니라 트리 해시인
# 이유: 이 시점엔 커밋이 아직 없고, 게이트가 검증하는 것은 히스토리가 아니라 내용이다
# (메시지만 고친 amend 처럼 내용이 같은 재작성은 그대로 유효해야 한다).
# git-dir 은 링크드 worktree 마다 다르므로 마커도 worktree 별로 분리된다. .git/ 안이라
# 절대 추적되지 않는다.
GIT_DIR_PATH="$(git rev-parse --absolute-git-dir)"
if TREE="$(git write-tree 2>/dev/null)"; then
  printf '%s' "$TREE" > "$GIT_DIR_PATH/harness-gate-tree"
else
  # 트리를 쓸 수 없으면(머지 중 등) 마커를 남기지 않는다 → pre-push 가 게이트를 다시 돈다.
  rm -f "$GIT_DIR_PATH/harness-gate-tree"
fi

exit 0
