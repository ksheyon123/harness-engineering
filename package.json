{
  "name": "@ksheyon123/harness-engineering",
  "version": "0.4.0",
  "type": "module",
  "description": "Claude Code 하네스 엔지니어링 — 역할 기반(기획자/개발자/QA) 문서 주도 개발 워크플로우",
  "license": "MIT",
  "author": "KangSeohyeon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksheyon123/harness-engineering.git"
  },
  "bugs": {
    "url": "https://github.com/ksheyon123/harness-engineering/issues"
  },
  "homepage": "https://github.com/ksheyon123/harness-engineering#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    ".claude/harness.md",
    ".claude/planner-mode.md",
    ".claude/planner/",
    ".claude/agents/",
    ".claude/hooks/",
    ".githooks/",
    "scripts/",
    "install/",
    "!**/*.test.mjs"
  ],
  "exports": {
    "./hooks/*": "./.claude/hooks/*",
    "./githooks/*": "./.githooks/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "harness": "./scripts/harness.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "posttest": "node .githooks/mark-verified.mjs"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@10.8.2"
}
