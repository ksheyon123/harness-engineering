node_modules
.DS_Store

.git-broken
.env

# 로컬 권한 승인 기록 — 개인 환경에 종속되므로 추적하지 않는다.
.claude/settings.local.json

# git worktree 는 저장소 밖 형제 디렉터리에 두는 것이 원칙.
# 내부(.claude/worktrees/)에 생기더라도 추적하지 않는다.
.claude/worktrees/

# post-checkout 이 남기는 발동 흔적. 사본이 만들어질 때마다 자라는 로컬 기록이라
# 커밋할 것이 아니다. A 에서는 .claude/ 가 통째로 무시되어 이 줄이 필요 없지만,
# 이 저장소는 .claude/ 를 커밋하므로 여기만 따로 뺀다 — pre-commit 이 git add -A 를
# 강제해서, 무시되지 않으면 다음 커밋에 반드시 딸려 들어간다.
.claude/post-checkout-trace.log
